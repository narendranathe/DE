{
  "name": "de-tracker-tests",
  "private": true,
  "description": "Dev-only test tooling for the Daily Executor tracker. The site itself needs no build step beyond tools/render_site.py.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "build:problems": "node tools/build_problems.js",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\""
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@electric-sql/pglite": "0.5.16",
    "esbuild": "^0.28.2",
    "pyodide": "314.0.7"
  }
}
